/* One visual language: paper, a quiet rule, and room around the words. */
Screen {
    background: $background;
    color: $foreground;
}
Button {
    min-width: 3;
    height: 3;
    border: none;
    background: $panel;
    color: $foreground;
    text-style: none;
}
Button:hover { background: $primary 18%; }
Button:focus { background: $primary 22%; text-style: bold; }
Button.-primary { background: $primary 22%; color: $foreground; }
Button.-warning { background: $warning 22%; color: $foreground; }
Input, Select { margin: 0 2 1 2; width: 1fr; }
Input { background: $surface; border: tall $panel; }
Input:focus { border: tall $primary; }
Select > SelectCurrent { border: tall $panel; background: $surface; }
Select:focus > SelectCurrent { border: tall $primary; }
SelectOverlay { border: solid $primary; }
OptionList {
    margin: 0 2;
    padding: 0;
    border: none;
    background: $background;
    height: 1fr;
    overflow-x: hidden;
}
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $primary 16%; color: $foreground; text-style: none; }
OptionList > .option-list--option-disabled { color: $accent; text-style: bold; }
OptionList:focus > .option-list--option-highlighted { background: $primary 22%; color: $foreground; }
.page-header { height: 3; margin: 1 2 0 2; }
.back-button { width: 8; margin-right: 2; }
.page-title { width: 1fr; height: auto; padding-top: 1; text-style: bold; color: $accent; }
.page-subtitle { height: auto; margin: 0 2 1 2; color: $text-muted; }
.page-scroll { padding: 0 2 1 2; overflow-x: hidden; }
.page-footnote { height: auto; margin: 1 2; color: $text-muted; }
.eyebrow { height: auto; color: $accent; text-style: bold; margin: 1 0; }
.muted { height: auto; color: $text-muted; }
.error { height: auto; color: $error; margin-bottom: 1; }
.button-row { height: 3; margin: 1 2; }
.button-row Button { width: 1fr; margin-right: 1; }
.button-row Button:last-child { margin-right: 0; }
.filter-row { height: 3; margin: 0 2 1 2; }
.filter-row Select { margin: 0 1 0 0; }
.filter-row Select:last-child { margin-right: 0; }
.collection-tabs { height: 3; margin: 0 2; }
.collection-tabs Button { width: 1fr; margin-right: 1; }
.collection-tabs Button:last-child { margin-right: 0; }
CollectionScreen > .eyebrow { margin: 1 3; }
/* Reader chrome remains small on a phone. */
#brand { height: 1; text-align: center; color: $accent; margin-top: 1; }
HeaderBar { height: 3; margin: 0 2; align-vertical: middle; }
HeaderBar Button { width: 5; height: 3; background: $background; color: $accent; }
#book-title { width: 1fr; height: auto; text-align: center; color: $foreground; }
#reader-nav, #reader-tools { height: 1; margin: 0 2; }
#reader-nav Button, #reader-tools Button { width: 1fr; height: 1; background: $surface; color: $secondary; }
#reader-nav Button:hover, #reader-tools Button:hover { color: $accent; background: $panel; }
#reading-scroll { height: 1fr; padding: 1 2; align-horizontal: center; overflow-x: hidden; scrollbar-size-vertical: 1; }
#verse-view { width: 1fr; height: auto; overflow: hidden; }
.verse-line { width: 1fr; height: auto; padding: 0 1; margin-bottom: 1; border-left: tall $background; }
.verse-line.selected { border-left: tall $primary; background: $primary 9%; }
.compact .verse-line { margin-bottom: 0; }
#paragraph { width: 1fr; height: auto; padding: 0 1; }
#reading-status { height: 1; text-align: center; color: $text-muted; margin: 0 1; }
#chapter-grid { grid-size: 5; grid-columns: 1fr; grid-rows: 3; grid-gutter: 1; height: auto; }
#chapter-grid Button { width: 1fr; }
#search-more { width: 1fr; margin: 1 2; }
#note-text { height: 1fr; margin: 0 2; border: tall $primary; background: $surface; }
#settings-scroll > Static { margin: 1 0 0 0; }
#settings-scroll Select, #settings-scroll Input { margin: 0 0 1 0; width: 1fr; }
#settings-scroll Switch { margin: 0 0 1 0; }
#plan-readings { height: auto; min-height: 4; margin: 0; }
#plan-progress { width: 1fr; margin: 1 0; }
#plan-progress Bar { width: 1fr; }
#plan-scroll > Button { width: 1fr; margin-top: 1; }
#plan-scroll .button-row { margin: 1 0; }
#plan-summary { margin: 1 0; }
.help-link { width: 1fr; margin-bottom: 1; }
#help-text { height: auto; margin: 2 0; }
#help-quit { width: 1fr; }
/* Sheets scroll on short terminals; their controls never scroll horizontally. */
Sheet { align: center middle; background: $background 75%; }
.sheet { width: 90%; max-width: 66; height: auto; max-height: 90%; border: round $primary; background: $surface; padding: 1 2; overflow-x: hidden; }
.sheet-title { height: auto; text-style: bold; margin-bottom: 1; }
.sheet .eyebrow { margin: 0 0 1 0; }
.sheet .button-row { margin: 0 0 1 0; }
.sheet Input { width: 1fr; margin: 0 0 1 0; }
.sheet > Button { width: 1fr; margin-bottom: 1; }
.swatches { height: 3; margin-bottom: 1; }
.swatches Button { width: 1fr; min-width: 3; margin-right: 1; }
.swatches Button:last-child { margin-right: 0; }
Toast { max-width: 90%; }

#verse-menu .eyebrow { margin: 0; }
#verse-menu #close-actions { height: 1; margin-bottom: 0; }
#verse-menu #translate-verse { margin-bottom: 0; }
#verse-menu .muted { margin-bottom: 1; }
/* Percentage width prevents sibling margins shrinking the full-width viewport. */
#reading-scroll, #brand, .page-scroll { width: 100%; }
