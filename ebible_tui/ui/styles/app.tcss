Screen { layers: base; }
#titlebar {
    content-align: left middle;
    height: 1;
    padding: 0 1;
    background: #222244;
    color: white;
}
NavPane {
    dock: left;
    width: 26;
    border: round #444;
    padding: 0 1;
    background: #111119;
}
#nav-title, #chapters-title {
    height: 1;
    content-align: left middle;
    color: #bbbbff;
}
#books, #chapters { height: 1fr; margin: 0; padding: 0 1; background: #0f0f14; border: round #444; }
VersePanel {
    border: round #444;
    padding: 1 2;
    background: #0f0f14;
}
#vv-title { color: #ffd27f; height: 1; }
#verse-list { height: 1fr; }
#verse-list ListItem > Static { width: 100%; text-wrap: wrap; content-align: left top; }
#vv-trans { text-wrap: wrap; padding: 0 1; width: 100%; border-top: none; }


# --- truncation override (no new widgets) ---
# --- no-ellipsis wrap (strict) ---



VersePanel { border: round #444; padding: 1 2; background: #0f0f14; }

# --- minimal wrap override (no overflow/height hacks) ---
# restored selector after cleanup

# --- translation panel sizing (verses + translation fit in 27x81) ---
#trans-title { height: 1; color: #a0ffa0; }
#trans-body  { height: 4; text-wrap: wrap; width: 100%; content-align: left top; }
TranslationPanel { border: round #444; padding: 0 1; background: #0f0f14; }
#verse-list { height: 1fr; }

Horizontal { height: 1fr; }                # main content fills between titlebar and footer
VersePanel { height: 1fr; }                 # verses area stretches

# --- layout fix (no gap, keep translation size) ---
NavPane { height: 1fr; }         # left column fills vertically
VersePanel { height: 1fr; }       # verses pane stretches to footer
#verse-list { height: 1fr; }      # list uses remaining space inside verses
#books, #chapters { height: 1fr; margin: 0; padding: 0 1; background: #0f0f14; }# split space in left column evenly

# scrollable translation body (override)
#trans-body { overflow: auto; text-wrap: wrap; width: 100%; content-align: left top; }

# --- scrollable translation (uses existing IDs) ---
#trans-box { height: 6; }
#vv-trans { height: 1fr; overflow: auto; scrollbar-gutter: stable; text-wrap: wrap; }

# --- scrollable translation (uses existing IDs) ---
#trans-box { height: 6; }
#vv-trans { height: 1fr; overflow: auto; scrollbar-gutter: stable; text-wrap: wrap; }

# --- override: stretch verses fully ---
VersePanel { padding: 0 2; }
#verse-list { height: 1fr; }

# --- override: split Books/Chapters into their own boxes ---
NavPane { border: none; padding: 0; background: transparent; }

# Titles stay unboxed; lists get borders like other panels
# Ensure each list fills its half and has spacing
#books, #chapters {
    border: round #444;
    padding: 0 1;
    background: #0f0f14;
}
#books    { height: 1fr; margin: 0; padding: 0 1; background: #0f0f14; border: round #444; }
#chapters { height: 1fr; margin: 1 0 0 0; }

# --- override: tighten title spacing ---
#nav-title, #chapters-title { margin: 0; }

# --- ensure nav titles are tight and centered ---
#nav-title, #chapters-title { margin: 0; padding: 0 1; }

# --- override: remove spacer between lists ---
#book-en { display: none; height: 0; padding: 0; margin: 0; }

# --- override: remove gap above chapters list ---
#chapters { margin: 0; }

# --- titles outside panels: hide internal, style external ---
#vv-title, #trans-title { display: none; }
#vv-title-out, #trans-title-out { height: 1; content-align: left middle; }
#vv-title-out { color: #ffd27f; }
#trans-title-out { color: #a0ffa0; }


/* Footer overrides: fixed bottom, no clipping on small terminals */

#footer {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #1a1a33;
    color: #e0e0ff;
    content-align: left middle;
    border-top: none;
    text-style: bold;
}
